<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BANJARNEGARA - PETA PENGGUNAAN LAHAN (BERBASIS LEAFLET.js)</title>
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
        }
        /* Header Banner seperti contoh 1000278983.png */
        .header-banner {
            background-color: #1a365d;
            color: white;
            text-align: center;
            padding: 10px 0;
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 1px;
            height: 25px;
        }
        #map {
            height: calc(100% - 45px);
            width: 100%;
        }
        /* Kotak Info Koordinat di Kiri Atas */
        .info-box {
            background: white;
            padding: 8px 12px;
            font-size: 13px;
            line-height: 18px;
            border-radius: 4px;
            box-shadow: 0 1px 5px rgba(0,0,0,0.4);
            min-width: 180px;
        }
        .info-box h4 {
            margin: 0 0 5px 0;
            color: #333;
            font-size: 14px;
            border-bottom: 1px dashed #999;
            padding-bottom: 4px;
        }
        /* Style untuk Label Teks di Peta */
        .landuse-label {
            background: rgba(255, 255, 255, 0);
            border: none;
            box-shadow: none;
            font-size: 11px;
            font-weight: bold;
            color: #111;
            text-shadow: -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff, 1px 1px 0 #fff;
        }
    </style>
</head>
<body>

    <div class="header-banner">BANJARNEGARA - PETA PENGGUNAAN LAHAN (BERBASIS LEAFLET.js)</div>
    <div id="map"></div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // 1. Inisialisasi Peta
        var map = L.map('map').setView([-7.395, 109.670], 11);

        // 2. Base Map Esri Terrain/World Imagery dengan jalanan transparan
        var baseMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Shaded_Relief/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Leaflet | &copy; ESRI World Imagery'
        }).addTo(map);
        
        var roads = L.tileLayer('https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}').addTo(map);

        // 3. Tambahkan Kotak Info di Kiri Atas seperti gambar 1000278983.png
        var info = L.control({position: 'topleft'});
        info.onAdd = function (map) {
            this._div = L.DomUtil.create('div', 'info-box');
            this.update();
            return this._div;
        };
        info.update = function (props) {
            this._div.innerHTML = '<h4>Kabupaten Banjarnegara Soil Map</h4>' + 
                '-7.420, 109.680<br>Level 13';
        };
        info.addTo(map);

        // 4. Pewarnaan Penggunaan Lahan (Kemiripan warna dengan gambar 1000278983.png)
        function getColor(landuse) {
            switch (landuse) {
                case 'HUTAN LINDUNG':       return '#1b5e20';
                case 'HUTAN PRODUKSI':      return '#880e4f';
                case 'PERTANIAN TANAMAN PANGAN': return '#ff7043';
                case 'PERKEBUNAN RAKYAT':    return '#6a1b9a';
                case 'PERMUKIMAN':          return '#f48fb1';
                case 'INDUSTRI':            return '#fbc02d';
                case 'PERAIRAN':            return '#1a237e';
                case 'WASILAH WISATA':      return '#311b92';
                case 'PADANG RUMPUT':       return '#81c784';
                default:                    return '#a1887f';
            }
        }

        // 5. Data Koordinat Asli Batas Lekukan Kabupaten Banjarnegara (Di-simplifikasi untuk Web)
        var banjarnegaraGeoJSON = {
            "type": "FeatureCollection",
            "features": [
                { "type": "Feature", "properties": { "landuse": "HUTAN LINDUNG", "label_lng": 109.730, "label_lat": -7.240 }, "geometry": { "type": "Polygon", "coordinates": [[[109.655,-7.205],[109.704,-7.234],[109.740,-7.202],[109.790,-7.210],[109.798,-7.235],[109.736,-7.280],[109.685,-7.260],[109.645,-7.230],[109.655,-7.205]]] } },
                { "type": "Feature", "properties": { "landuse": "PERTANIAN TANAMAN PANGAN", "label_lng": 109.640, "label_lat": -7.300 }, "geometry": { "type": "Polygon", "coordinates": [[[109.645,-7.230],[109.685,-7.260],[109.700,-7.300],[109.680,-7.330],[109.615,-7.335],[109.610,-7.280],[109.645,-7.230]]] } },
                { "type": "Feature", "properties": { "landuse": "HUTAN PRODUKSI", "label_lng": 109.735, "label_lat": -7.310 }, "geometry": { "type": "Polygon", "coordinates": [[[109.685,-7.260],[109.736,-7.280],[109.742,-7.340],[109.695,-7.350],[109.680,-7.330],[109.685,-7.260]]] } },
                { "type": "Feature", "properties": { "landuse": "PERKEBUNAN RAKYAT", "label_lng": 109.570, "label_lat": -7.370 }, "geometry": { "type": "Polygon", "coordinates": [[[109.615,-7.335],[109.680,-7.330],[109.640,-7.400],[109.580,-7.410],[109.550,-7.360],[109.615,-7.335]]] } },
                { "type": "Feature", "properties": { "landuse": "PERMUKIMAN", "label_lng": 109.650, "label_lat": -7.410 }, "geometry": { "type": "Polygon", "coordinates": [[[109.680,-7.330],[109.695,-7.350],[109.710,-7.400],[109.680,-7.460],[109.630,-7.450],[109.640,-7.400],[109.680,-7.330]]] } },
                { "type": "Feature", "properties": { "landuse": "INDUSTRI", "label_lng": 109.715, "label_lat": -7.435 }, "geometry": { "type": "Polygon", "coordinates": [[[109.695,-7.350],[109.742,-7.340],[109.750,-7.420],[109.710,-7.470],[109.680,-7.460],[109.710,-7.400],[109.695,-7.350]]] } },
                { "type": "Feature", "properties": { "landuse": "HUTAN PRODUKSI", "label_lng": 109.670, "label_lat": -7.480 }, "geometry": { "type": "Polygon", "coordinates": [[[109.630,-7.450],[109.680,-7.460],[109.710,-7.470],[109.690,-7.530],[109.620,-7.510],[109.630,-7.450]]] } },
                { "type": "Feature", "properties": { "landuse": "PERAIRAN", "label_lng": 109.620, "label_lat": -7.535 }, "geometry": { "type": "Polygon", "coordinates": [[[109.620,-7.510],[109.690,-7.530],[109.660,-7.570],[109.590,-7.550],[109.620,-7.510]]] } },
                { "type": "Feature", "properties": { "landuse": "PADANG RUMPUT", "label_lng": 109.530, "label_lat": -7.510 }, "geometry": { "type": "Polygon", "coordinates": [[[109.580,-7.410],[109.630,-7.450],[109.620,-7.510],[109.590,-7.550],[109.480,-7.520],[109.500,-7.470],[109.580,-7.410]]] } }
            ]
        };

        // 6. Menggambar Lapisan Poligon & Label Penggunaan Lahan
        L.geoJSON(banjarnegaraGeoJSON, {
            style: function (feature) {
                return {
                    fillColor: getColor(feature.properties.landuse),
                    weight: 1.5,
                    opacity: 1,
                    color: '#263238',
                    fillOpacity: 0.75
                };
            },
            onEachFeature: function (feature, layer) {
                // Menambahkan label teks statis tepat di tengah poligon wilayahnya
                if (feature.properties.landuse) {
                    L.marker([feature.properties.label_lat, feature.properties.label_lng], {
                        icon: L.divIcon({
                            className: 'landuse-label',
                            html: feature.properties.landuse,
                            iconSize: [100, 20]
                        })
                    }).addTo(map);
                }
                layer.bindPopup("<b>Kategori Lahan:</b> " + feature.properties.landuse);
            }
        }).addTo(map);

    </script>
</body>
</html>
